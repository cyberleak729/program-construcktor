<Window x:Class="GameVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameVault — твой лаунчер игр" Height="760" Width="1320"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⬢ GameVault" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4CC2FF"/>
                            <GradientStop Color="#7C5CFF"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="TabLibrary" Content="Библиотека" Style="{StaticResource GhostBtn}"
                            Margin="0,0,8,0" Click="TabLibrary_Click"/>
                    <Button x:Name="TabDownloads" Content="Загрузки" Style="{StaticResource GhostBtn}"
                            Click="TabDownloads_Click"/>
                </StackPanel>

                <TextBox Grid.Column="2" x:Name="SearchBox" Width="260" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged" ToolTip="Фильтр библиотеки"/>
            </Grid>
        </Border>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="16,7">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Поиск игр (торрент)" Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,8,0" Click="TorrentSearch_Click"/>
                    <Button Content="Настройки" Style="{StaticResource GhostBtn}" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- СЕТКА БИБЛИОТЕКИ -->
            <ScrollViewer x:Name="LibraryView" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="235" Margin="8" CornerRadius="12" Background="{StaticResource Panel}"
                                    MouseLeftButtonUp="Card_Click" Cursor="Hand">
                                <StackPanel>
                                    <Grid Height="107">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Background="#22000000" CornerRadius="12,12,0,0">
                                            <TextBlock Text="{Binding PlatformDisplay}" Foreground="#BFEAFFFB"
                                                       FontSize="11" Margin="8,6" HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="10,8">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,24,0"/>
                                        <TextBlock Text="★" FontSize="16" Foreground="#FFD166"
                                                   HorizontalAlignment="Right" Cursor="Hand"
                                                   MouseLeftButtonUp="Fav_Click">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0.25"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ПАНЕЛЬ ЗАГРУЗОК -->
            <Border x:Name="DownloadsView" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="{StaticResource Panel}" CornerRadius="12" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Торрент-загрузки" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Downloads}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6" Width="880" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="⏸" Style="{StaticResource GhostBtn}" Padding="8,3" Margin="0,0,4,0"
                                                Click="PauseDl_Click" Tag="{Binding}"/>
                                        <Button Content="▶" Style="{StaticResource GhostBtn}" Padding="8,3" Margin="0,0,4,0"
                                                Click="ResumeDl_Click" Tag="{Binding}"/>
                                        <Button Content="✕" Style="{StaticResource GhostBtn}" Padding="8,3" Margin="0,0,4,0"
                                                Click="CancelDl_Click" Tag="{Binding}"/>
                                        <Button Content="В библиотеку" Style="{StaticResource PrimaryBtn}" Padding="8,3"
                                                Click="ImportDl_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding State}" Width="130" Foreground="{StaticResource Text2}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                                   Foreground="{StaticResource Text2}" HorizontalAlignment="Right" Margin="8,0"/>
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1"
                                                     Height="8" Foreground="{StaticResource Accent}" Background="{StaticResource Panel2}"
                                                     BorderThickness="0"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- БОКОВАЯ ПАНЕЛЬ ВЫБРАННОЙ ИГРЫ -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Margin="14,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Выберите игру из библиотеки" Foreground="{StaticResource Text2}"
                               FontSize="14" TextWrapping="Wrap"/>

                    <Image x:Name="DetailCover" Height="150" Stretch="UniformToFill" Margin="0,12"
                           Visibility="Collapsed"/>
                    <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="DetailPlatform" Foreground="{StaticResource Text2}" Margin="0,4,0,14"
                               Visibility="Collapsed"/>

                    <Button x:Name="PlayBtn" Content="ИГРАТЬ" Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Stretch" FontSize="16" Visibility="Collapsed"
                            Click="Play_Click"/>
                    <Button x:Name="RemoveBtn" Content="Удалить из библиотеки" Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="Collapsed"
                            Click="Remove_Click"/>

                    <Separator Margin="0,16" Background="{StaticResource Panel2}"/>
                    <TextBlock Text="Добавить вручную" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="+ Локальная игра (.exe / .html)" Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="AddExe_Click"/>
                    <Button Content="+ HTML-игра из папки" Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Stretch" Click="AddHtml_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="GameVault.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск игр · торрент-каталог" Height="640" Width="900"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" FontSize="15" KeyDown="QueryBox_KeyDown"
                     Text="Введите название игры…"/>
            <Button Grid.Column="1" Content="Искать" Style="{StaticResource PrimaryBtn}"
                    Margin="10,0,0,0" Click="Search_Click"/>
        </Grid>

        <TextBlock x:Name="HintBar" DockPanel.Dock="Bottom" Foreground="{StaticResource Text2}"
                   Margin="0,8,0,0"
                   Text="Двойной клик по строке — скачать торрент и добавить игру в библиотеку."/>

        <ListBox x:Name="ResultsList" Background="{StaticResource Panel}" BorderThickness="0"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource Text2}" Margin="8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding SeedText}" Foreground="#6BE58B"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

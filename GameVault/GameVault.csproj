<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GameVault</AssemblyName>
    <RootNamespace>GameVault</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Чтение реестра (Steam/Epic/GOG пути) -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Встроенный торрент-движок + магнет-ссылки -->
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <!-- Встроенный браузер для HTML-игр (Edge WebView2) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>

